[Unit]
Description=PrivatePartyNet relay (forwards members' encrypted datagrams; reads none of them)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ppn-relay
Group=ppn-relay
EnvironmentFile=-/etc/ppn-relay/options
ExecStart=/usr/bin/python3 /opt/ppn-relay/ppn_relay.py --secret-file /etc/ppn-relay/secret \
    --udp-port ${UDP_PORT} --tls-port ${TLS_PORT} --cert /etc/ppn-relay/relay.crt --key /etc/ppn-relay/relay.key \
    --rate-kbps ${RATE_KBPS}
Environment=UDP_PORT=3479 TLS_PORT=443 RATE_KBPS=8000
Restart=on-failure
RestartSec=3

# Port 443 without running as root, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/ppn-relay /opt/ppn-relay
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
