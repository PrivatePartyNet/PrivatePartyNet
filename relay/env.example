# Copy to .env beside docker-compose.yml and fill in. Keep .env private: the secret lets anyone use your relay.
# Make a secret with:  docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(24))"
PPN_RELAY_SECRET=
# The VPS's public IPv4 address, as your provider shows it.
PUBLIC_IP=
# The most each member sends through one relay channel, in kilobits a second.
PPN_RELAY_RATE_KBPS=8000
