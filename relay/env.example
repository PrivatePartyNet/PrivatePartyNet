# Copy to .env beside docker-compose.yml and fill in. The relay secret goes in a file of its own, relay/secret.
# The VPS's public IPv4 address, as your provider shows it.
PUBLIC_IP=
# Its public IPv6 address, if it has one: members with only IPv6 then reach the relay too.
PUBLIC_IP6=
# The most each member sends through one relay channel, in kilobits a second.
PPN_RELAY_RATE_KBPS=8000
